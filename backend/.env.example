PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_URL/safehome_rag
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=3d
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
AI_PROVIDER=claude
AI_FALLBACK_ENABLED=true
AI_REQUEST_TIMEOUT_MS=30000
CHATBOT_MAX_MESSAGE_LENGTH=2000
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
LOGIN_RATE_LIMIT_MAX=10
MAX_IMAGE_UPLOAD_MB=5
MAX_EXCEL_UPLOAD_MB=5
MAX_EXCEL_ROWS=1000
MAX_EXCEL_SHEETS=3
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=feature-hash-v1
MONGODB_VECTOR_INDEX_NAME=knowledge_vector_index
VECTOR_SEARCH_ENABLED=false
SLA_MONITOR_ENABLED=true
SLA_MONITOR_INTERVAL_MINUTES=15

# Payment Gateway (Razorpay / Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloud Storage (AWS S3) - Optional: Falls back to local /uploads if omitted
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Omnichannel Alerts (Twilio SMS & WhatsApp) - Optional: Logs to audit if omitted
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# Monitoring & Caching
REDIS_URL=redis://localhost:6379
SENTRY_DSN=
