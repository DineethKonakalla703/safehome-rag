# Optional. Where the app reaches the SafeHome backend.
# Leave unset in development: the app uses the IP of the computer running `npx expo start`, port 5000.
# Set it for a phone on another network or for a deployed backend. Never put secrets here —
# every EXPO_PUBLIC_ value is bundled into the app.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5000/api
